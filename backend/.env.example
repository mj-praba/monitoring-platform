# NOTE: DB/backend host ports are shifted by one (5433/27018/6380/8001/8124/9095) because this
# machine already runs another project's stack on the Postgres/Mongo/Redis/8000 defaults.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8001
WS_PORT=8002
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006

# ---------------------------------------------------------------------------
# Auth (JWT access + refresh tokens)
# ---------------------------------------------------------------------------
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
DEVICE_TOKEN_EXPIRE_MINUTES=43200
PAIRING_CODE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Application data (PostgreSQL) — tenants, workspaces, locations, roles,
# permissions, users, refresh tokens, devices, pairing sessions.
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monitoring_platform
POSTGRES_SCHEMA=public
POSTGRES_SSL=false

# ---------------------------------------------------------------------------
# Document database (MongoDB) — durable device_metrics documents, written
# by apps/workers/ingestion-worker.
# ---------------------------------------------------------------------------
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=monitoring_platform
MONGO_SSL=false

# ---------------------------------------------------------------------------
# Cache / pub-sub (Redis) — wired into the stack but no longer used by the
# live-metrics pipeline; see Event stream (Kafka) below, which replaced it
# as the transport between apps/websocket and its consumers.
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# ---------------------------------------------------------------------------
# Event stream (Kafka) — the live transport between apps/websocket
# (producer) and its two consumers: apps/workers/ingestion-worker (durable
# Mongo writes) and apps/websocket's own in-process dashboard fan-out.
# ---------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9095
KAFKA_CLIENT_ID=monitoring-platform
KAFKA_SSL=false

# ---------------------------------------------------------------------------
# Analytics (ClickHouse) — infra-only for now: connection + migration
# mechanism wired up, no application data written yet.
# ---------------------------------------------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8124
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=app
CLICKHOUSE_DB=monitoring_platform
CLICKHOUSE_SSL=false
