{
  "name": "monitoring-platform-backend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "copy:clickhouse-migrations": "mkdir -p dist/packages/database/clickhouse/migrations && cp packages/database/clickhouse/migrations/*.sql dist/packages/database/clickhouse/migrations/",
    "build:api": "nest build && pnpm copy:clickhouse-migrations",
    "build:websocket": "tsc -p apps/websocket/tsconfig.json && tsc-alias -p apps/websocket/tsconfig.json",
    "build:ingestion-worker": "tsc -p apps/workers/ingestion-worker/tsconfig.json && tsc-alias -p apps/workers/ingestion-worker/tsconfig.json",
    "build:cron-worker": "tsc -p apps/workers/cron-worker/tsconfig.json && tsc-alias -p apps/workers/cron-worker/tsconfig.json",
    "build": "pnpm clean && pnpm build:api && pnpm build:websocket && pnpm build:ingestion-worker && pnpm build:cron-worker",
    "start:api": "node dist/apps/api/src/main.js",
    "start:websocket": "node dist/apps/websocket/src/main.js",
    "start:ingestion-worker": "node dist/apps/workers/ingestion-worker/src/main.js",
    "start:cron-worker": "node dist/apps/workers/cron-worker/src/main.js",
    "dev:api": "nest start --watch",
    "dev:websocket": "ts-node -r tsconfig-paths/register apps/websocket/src/main.ts",
    "dev:ingestion-worker": "ts-node -r tsconfig-paths/register apps/workers/ingestion-worker/src/main.ts",
    "dev:cron-worker": "ts-node -r tsconfig-paths/register apps/workers/cron-worker/src/main.ts",
    "typecheck": "tsc -p apps/api/tsconfig.app.json --noEmit && tsc -p apps/websocket/tsconfig.json --noEmit && tsc -p apps/workers/ingestion-worker/tsconfig.json --noEmit && tsc -p apps/workers/cron-worker/tsconfig.json --noEmit",
    "typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d packages/database/postgres/data-source.ts",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "seed:demo": "ts-node -r tsconfig-paths/register packages/database/postgres/seeds/demo.seed.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.11.1",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.9.0",
    "nest-winston": "^1.10.2",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "winston": "^3.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
