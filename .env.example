# Backend (copy to backend/.env for local `pnpm dev` runs; docker-compose sets these itself)
# NOTE: DB/backend host ports are shifted by one (5433/27018/6380/8001) because this
# machine already runs another project's stack on the Postgres/Mongo/Redis/8000 defaults.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/monitoring_platform
MONGO_URL=mongodb://localhost:27018
MONGO_DB_NAME=monitoring_platform
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006
PORT=8001

# Frontend (copy to frontend/.env)
VITE_API_BASE_URL=http://localhost:8001
VITE_WS_BASE_URL=ws://localhost:8001

# Mobile (copy to mobile/.env, read via app.config.js / expo-constants)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8001
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8001
