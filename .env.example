# Backend (copy to backend/.env for local `pnpm dev` runs; docker-compose sets these itself)
# NOTE: DB/backend host ports are shifted by one (5433/27018/6380/8001/8124) because this
# machine already runs another project's stack on the Postgres/Mongo/Redis/8000 defaults.
# See backend/.env.example for the full, sectioned list (Application / Auth / Application
# data (Postgres) / Document database (Mongo) / Cache (Redis) / Analytics (ClickHouse)).
NODE_ENV=development
PORT=8001
WS_PORT=8002
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006

JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
DEVICE_TOKEN_EXPIRE_MINUTES=43200
PAIRING_CODE_TTL_SECONDS=300

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monitoring_platform
POSTGRES_SCHEMA=public
POSTGRES_SSL=false

MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=monitoring_platform
MONGO_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8124
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=app
CLICKHOUSE_DB=monitoring_platform
CLICKHOUSE_SSL=false

# Frontend (copy to frontend/.env)
VITE_API_BASE_URL=http://localhost:8001
VITE_WS_BASE_URL=ws://localhost:8002

# Mobile (copy to mobile/.env, read via app.config.js / expo-constants)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8001
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8002
